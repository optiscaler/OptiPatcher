#include <winresrc.h>
#include "git_version.h" // generated into $(IntDir) by the GenerateGitVersion target

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,0,0,0
 PRODUCTVERSION 0,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "OptiPatcher"
            VALUE "FileVersion", OPTIPATCHER_VERSION_STR
            VALUE "InternalName", "OptiPatcher"
            VALUE "OriginalFilename", "OptiPatcher.asi"
            VALUE "ProductName", "OptiPatcher"
            VALUE "ProductVersion", OPTIPATCHER_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
